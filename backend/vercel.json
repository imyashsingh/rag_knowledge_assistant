{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "dest": "app/main.py"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.10"
  },
  "functions": {
    "app/main.py": {
      "maxDuration": 30
    }
  }
}
